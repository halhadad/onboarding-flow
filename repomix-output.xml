{% extends "base.html" %}
{% block content %}
<div class="bg-white shadow rounded-lg p-8 max-w-xl mx-auto mt-6">
    <div class="mb-6 border-b border-gray-100 pb-4">
        <span class="text-xs font-bold text-blue-600 tracking-widest uppercase">{{ country }} &middot; {{ type }}</span>
        <h2 class="text-2xl font-bold text-gray-800 mt-1">{{ step.title }}</h2>
        <p class="text-gray-600 text-sm mt-1">{{ step.description }}</p>
        <div class="mt-4">
            <div class="flex justify-between text-xs text-gray-500 mb-1">
                <span>Step {{ current_step_number }} of {{ total_steps }}</span>
                <span>{{ progress_percent }}%</span>
            </div>
            <div class="h-2 bg-gray-100 rounded overflow-hidden">
                <div class="h-full bg-blue-600" style="width: {{ progress_percent }}%"></div>
            </div>
        </div>
    </div>

    {% if error_message %}
    <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded text-sm text-red-700">
        <strong>Validation Error:</strong> {{ error_message }}
    </div>
    {% endif %}

    <form action="/application/{{ application_id }}/step/{{ step.step_id }}" method="POST" class="space-y-6">
        <input type="hidden" name="country" value="{{ country }}">
        <input type="hidden" name="type" value="{{ type }}">
        <input type="hidden" name="version" value="{{ version }}">

        {% for field in step.fields %}
        <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2">
                {{ field.field_name | replace('_', ' ') }}
                {% if field.is_required %}<span class="text-red-500">*</span>{% endif %}
            </label>
            
            {% if field.field_type == 'text' %}
                <input type="text" name="{{ field.field_name }}" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-blue-500 outline-none" {% if field.is_required %}required{% endif %}>
            {% elif field.field_type == 'number' %}
                <input type="number" min="0" step="any" name="{{ field.field_name }}" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-blue-500 outline-none" {% if field.is_required %}required{% endif %}>
            {% elif field.field_type == 'select' %}
                <select name="{{ field.field_name }}" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-blue-500 outline-none" {% if field.is_required %}required{% endif %}>
                    {% for option in field.options %}
                    <option value="{{ option }}">{{ option }}</option>
                    {% endfor %}
                </select>
            {% elif field.field_type == 'boolean' %}
                <div class="flex items-center space-x-3 mt-1">
                    <input type="checkbox" name="{{ field.field_name }}" value="true" class="h-4 w-4 border-gray-300 rounded text-blue-600 focus:ring-blue-500">
                    <span class="text-sm text-gray-600">Yes</span>
                </div>
            {% endif %}
        </div>
        {% endfor %}

        <div class="pt-4 border-t border-gray-100 flex justify-between items-center">
            <span class="text-xs text-gray-400">Transaction State Version: {{ version }}</span>
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded shadow transition-colors">
                Continue Next Step &rarr;
            </button>
        </div>
    </form>
</div>
{% endblock %}
